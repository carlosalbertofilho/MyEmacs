#!/usr/bin/env python3
"""
log-triage: Triage test and build failure logs from 'just check-all' via local Ollama AI.
Outputs a 15-line Markdown/Org summary if errors occur, or success message if clean.
"""

import sys
import os
import json
import re
import urllib.request
import urllib.error

def query_ollama(prompt, model="qwen2.5-coder:1.5b"):
    """Send log triage prompt to local Ollama instance."""
    url = "http://localhost:11434/api/generate"
    payload = {
        "model": model,
        "prompt": prompt,
        "stream": False,
        "format": "json"
    }
    data = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(url, data=data, headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=60) as response:
            res_json = json.loads(response.read().decode("utf-8"))
            return res_json.get("response", "")
    except Exception as e:
        return f"Error querying local Ollama ({url}): {e}"

def main():
    if len(sys.argv) > 1 and os.path.exists(sys.argv[1]):
        with open(sys.argv[1], "r", encoding="utf-8", errors="ignore") as f:
            log_content = f.read()
    else:
        log_content = sys.stdin.read()

    if not log_content.strip():
        print("✅ Todos os testes e checks passaram limpos.")
        return

    # Check for error signals in logs
    has_explicit_error = False
    
    # Check lines for failure indicators
    lines = log_content.splitlines()
    for line in lines:
        if re.search(r"\b(FAILED|Error:|error:|checkdoc: \d+ files with issues|unexpected|FAILED \()\b", line):
            # Exclude lines reporting zero errors (e.g. "0 unexpected", "0 failures")
            if re.search(r"0\s+(unexpected|failures|errors)", line, re.IGNORECASE):
                continue
            has_explicit_error = True
            break

    if not has_explicit_error:
        print("✅ Todos os testes e checks passaram limpos.")
        return

    prompt = f"""Você é um triador de logs de compilação/testes do Emacs Lisp / Just.
Analise o log de erros a seguir e responda estritamente no seguinte formato JSON:
{{
  "summary": "Categorização: <sua categorização (ex: Compilação Bytecode, ERT Unit Test, Checkdoc, etc.)>\\nCausa Raiz: <causa raiz e descrição resumida do erro>",
  "error_count": <número inteiro de erros/falhas>,
  "recommendations": ["<recomendação 1>", "<recomendação 2>", ...]
}}

LOG DE ERROS:
{log_content[-6000:]}
"""

    summary_raw = query_ollama(prompt)
    
    parsed = None
    try:
        clean_content = summary_raw.strip()
        if clean_content.startswith("```"):
            lines = clean_content.splitlines()
            if lines[0].startswith("```"):
                lines = lines[1:]
            if lines and lines[-1].strip() == "```":
                lines = lines[:-1]
            clean_content = "\n".join(lines).strip()
            
        parsed = json.loads(clean_content)
    except Exception as e:
        print(f"⚠️ JSON parsing of Ollama response failed: {e}. Falling back to raw output.", file=sys.stderr)
        
    print("\n--- RESUMO DE TRIAGEM (Ollama AI) ---")
    if parsed and isinstance(parsed, dict) and "summary" in parsed and "error_count" in parsed and "recommendations" in parsed:
        summary_val = parsed.get("summary", "")
        category = "Outro / Não categorizado"
        clean_summary = summary_val
        category_match = re.search(r"Categorização:\s*([^\n]+)", summary_val, re.IGNORECASE)
        if category_match:
            category = category_match.group(1).strip()
            clean_summary = re.sub(r"Categorização:\s*[^\n]+\n?", "", summary_val, flags=re.IGNORECASE).strip()
            
        print(f"Categorização: {category}")
        print(f"Erros detectados: {parsed.get('error_count', 0)}")
        print(f"Resumo: {clean_summary}")
        print("Recomendações:")
        for rec in parsed.get("recommendations", []):
            print(f"  - {rec}")
    else:
        print(summary_raw)

if __name__ == "__main__":
    main()
