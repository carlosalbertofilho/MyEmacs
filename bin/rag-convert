#!/usr/bin/env python3
"""
rag-convert: Convert documents (PDF, HTML, MD, ZIP, YouTube) to standardized Org-Mode for RAG cache.
Uses markitdown for conversion and structures content dynamically via:
1. MLX Local (macOS GPU, private, cost-free)
2. Ollama Local (CPU fallback, private, cost-free)
3. Gemini API Cloud (Gemini 2.5 Flash, fast, Free Tier fallback)
"""

import os
import sys
import json
import re
import urllib.request
import urllib.parse
import urllib.error

def convert_to_markdown(input_source):
    """Convert input source (file path or URL) to Markdown text using markitdown."""
    try:
        from markitdown import MarkItDown
        md = MarkItDown()
        result = md.convert(input_source)
        return result.text_content
    except Exception as e:
        print(f"MarkItDown conversion error: {e}", file=sys.stderr)
        # Fallback for local files only
        if not input_source.startswith(("http://", "https://")):
            try:
                with open(input_source, "r", encoding="utf-8", errors="ignore") as f:
                    return f.read()
            except Exception as read_err:
                print(f"Fallback read error: {read_err}", file=sys.stderr)
        sys.exit(1)

def query_mlx(prompt, model):
    """Send prompt to local MLX instance via HTTP POST (OpenAI compatible)."""
    url = "http://127.0.0.1:8081/v1/chat/completions"
    payload = {
        "model": model,
        "messages": [{"role": "user", "content": prompt}],
        "temperature": 0.2,
        "max_tokens": 2048  # Reduced to avoid excessive generation delays
    }
    data = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(url, data=data, headers={"Content-Type": "application/json"})
    try:
        # Reduced HTTP timeout to fail fast to Ollama/Gemini if GPU server is unresponsive
        with urllib.request.urlopen(req, timeout=15) as response:
            res_json = json.loads(response.read().decode("utf-8"))
            
            choices = res_json.get("choices", [])
            if choices:
                message = choices[0].get("message", {})
                content = message.get("content") or message.get("reasoning_content") or message.get("reasoning")
                if not content:
                    content = choices[0].get("text")
                
                if content:
                    content = re.sub(r'<think>.*?</think>', '', content, flags=re.DOTALL)
                    content = re.sub(r'^Thinking Process:.*?\n\n', '', content, flags=re.DOTALL)
                    content = content.strip()
                    return content
            return None
    except Exception as e:
        print(f"MLX request error: {e}", file=sys.stderr)
        return None

def query_ollama(prompt):
    """Send prompt to local Ollama instance via HTTP POST, auto-detecting active model."""
    model = "qwen2.5-coder:3b"
    try:
        req_tags = urllib.request.urlopen("http://localhost:11434/api/tags", timeout=2)
        tags_data = json.loads(req_tags.read().decode("utf-8"))
        available = [m["name"] for m in tags_data.get("models", [])]
        if available:
            if model not in available:
                matching = [m for m in available if "qwen" in m or "coder" in m]
                model = matching[0] if matching else available[0]
    except Exception:
        pass

    url = "http://localhost:11434/api/generate"
    payload = {
        "model": model,
        "prompt": prompt,
        "stream": False,
        "options": {
            "num_predict": 2048
        }
    }
    data = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(url, data=data, headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=15) as response:
            res_json = json.loads(response.read().decode("utf-8"))
            content = res_json.get("response", "")
            if content:
                content = re.sub(r'<think>.*?</think>', '', content, flags=re.DOTALL)
                content = content.strip()
                return content
            return None
    except Exception as e:
        print(f"Ollama request error: {e}", file=sys.stderr)
        return None

def query_gemini_api(prompt):
    """Send prompt to official Gemini Developer API (AI Studio) as a Free Tier cloud fallback."""
    api_key = os.getenv("GEMINI_API_KEY") or os.getenv("GOOGLE_API_KEY")
    if not api_key:
        print("Gemini API skipped: API Key not found in environment.", file=sys.stderr)
        return None
    
    url = f"https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key={api_key}"
    payload = {
        "contents": [{"parts": [{"text": prompt}]}]
    }
    data = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(url, data=data, headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=20) as response:
            res_json = json.loads(response.read().decode("utf-8"))
            candidates = res_json.get("candidates", [])
            if candidates:
                content = candidates[0].get("content", {})
                parts = content.get("parts", [])
                if parts:
                    text = parts[0].get("text", "")
                    # Clean markdown code blocks if the model wrapped output
                    text = re.sub(r'^```org\n', '', text)
                    text = re.sub(r'^```\n', '', text)
                    text = re.sub(r'\n```$', '', text)
                    return text.strip()
            return None
    except Exception as e:
        print(f"Gemini API request error: {e}", file=sys.stderr)
        return None

def detect_and_query_ai(prompt):
    """Detects active local/cloud backends and queries the best available model."""
    # 1. Tenta MLX Local
    try:
        req_url = "http://127.0.0.1:8081/v1/models"
        with urllib.request.urlopen(req_url, timeout=2) as response:
            models_data = json.loads(response.read().decode("utf-8"))
            available_models = [m["id"] for m in models_data.get("data", [])]
            
            preferred = ["mlx-community/Qwen3.5-9B-MLX-4bit", "mlx-community/Qwen3-14B-4bit"]
            model = next((m for m in preferred if m in available_models), None)
            if not model and available_models:
                model = available_models[0]
                
            if model:
                print(f"🤖 Formatting via MLX Local (model: {model})...")
                res = query_mlx(prompt, model)
                if res:
                    return res
    except Exception:
        pass

    # 2. Tenta Ollama Local
    try:
        # Check if Ollama is running before calling
        urllib.request.urlopen("http://localhost:11434/api/tags", timeout=1)
        print("🤖 Formatting via Ollama Local...")
        res = query_ollama(prompt)
        if res:
            return res
    except Exception:
        pass

    # 3. Fallback para Gemini Developer API (AI Studio Free Tier)
    print("🤖 Formatting via Gemini Developer API (gemini-2.5-flash cloud fallback)...")
    res = query_gemini_api(prompt)
    if res:
        return res

    return None

def main():
    if len(sys.argv) < 2:
        print("Usage: rag-convert <input-file-or-url> [output-file]")
        sys.exit(1)

    input_source = sys.argv[1]
    is_url = input_source.startswith(("http://", "https://"))

    if not is_url:
        input_source = os.path.abspath(input_source)
        if not os.path.exists(input_source):
            print(f"File not found: {input_source}", file=sys.stderr)
            sys.exit(1)
        filename = os.path.basename(input_source)
    else:
        parsed_url = urllib.parse.urlparse(input_source)
        if "youtube.com" in parsed_url.netloc or "youtu.be" in parsed_url.netloc:
            filename = "youtube_video"
        else:
            filename = parsed_url.netloc.replace(".", "_")

    base_name = os.path.splitext(filename)[0]
    title = base_name.replace("_", " ").replace("-", " ").title()

    if len(sys.argv) >= 3:
        output_path = os.path.abspath(sys.argv[2])
    else:
        script_dir = os.path.dirname(os.path.abspath(__file__))
        docs_dir = os.path.abspath(os.path.join(script_dir, "..", "docs"))
        output_path = os.path.join(docs_dir, f"{base_name}.org")

    print(f"📄 Processing input source: {input_source}")
    raw_text = convert_to_markdown(input_source)

    if not raw_text:
        print("Error: Conversion returned empty content.", file=sys.stderr)
        sys.exit(1)

    truncated_text = raw_text[:8000]

    prompt = f"""Estruture o conteúdo abaixo como um documento Org-Mode padronizado para RAG Cache.

REQUISITOS OBRIGATÓRIOS:
1. Inclua os metadados no topo:
   #+TITLE: {title}
   #+AUTHOR: Carlos Filho
   #+FILETAGS: :RAG:DOCS:
2. Use títulos de seção Org-Mode com '*' (* Título, ** Subtítulo).
3. Mantenha tabelas formatadas em estilo Org (| col | col |).
4. Retorne APENAS o código Org-Mode puro (sem marcas ```org).

CONTEÚDO:
{truncated_text}
"""

    # Carrega chaves de API do agenix para o ambiente se existirem
    if os.path.exists("/etc/api-keys.sh"):
        try:
            with open("/etc/api-keys.sh", "r") as f:
                content = f.read()
                # Procura por export KEY=VALUE
                for line in content.splitlines():
                    match = re.match(r'^\s*export\s+(\w+)=[\'"]?([^\'"]+)[\'"]?', line)
                    if match:
                        os.environ[match.group(1)] = match.group(2)
        except Exception:
            pass

    org_content = detect_and_query_ai(prompt)

    if not org_content:
        print("⚠️ Failed to receive formatted output from local and cloud AI. Saving fallback raw Org file.", file=sys.stderr)
        org_content = f"#+TITLE: {title}\n#+AUTHOR: Carlos Filho\n#+FILETAGS: :RAG:DOCS:\n\n{raw_text}"

    os.makedirs(os.path.dirname(output_path), exist_ok=True)
    with open(output_path, "w", encoding="utf-8") as f:
        f.write(org_content)

    print(f"✅ Document successfully converted to Org-Mode: {output_path}")

if __name__ == "__main__":
    main()
