#!/usr/bin/env python3
"""
rag-convert: Convert documents (PDF, HTML, MD) to standardized Org-Mode for RAG cache.
Uses markitdown if available, and structures content via Ollama (qwen2.5-coder:3b).
"""

import os
import sys
import json
import urllib.request
import urllib.error

def convert_to_markdown(filepath):
    """Convert input document to Markdown text using markitdown or plain reading."""
    try:
        from markitdown import MarkItDown
        md = MarkItDown()
        result = md.convert(filepath)
        return result.text_content
    except Exception:
        try:
            with open(filepath, "r", encoding="utf-8", errors="ignore") as f:
                return f.read()
        except Exception as e:
            print(f"Error reading file {filepath}: {e}", file=sys.stderr)
            sys.exit(1)

def query_ollama(prompt, model="qwen2.5-coder:3b"):
    """Send prompt to local Ollama instance via HTTP POST."""
    url = "http://localhost:11434/api/generate"
    payload = {
        "model": model,
        "prompt": prompt,
        "stream": False
    }
    data = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(url, data=data, headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=120) as response:
            res_json = json.loads(response.read().decode("utf-8"))
            return res_json.get("response", "")
    except Exception as e:
        print(f"Ollama request error: {e}", file=sys.stderr)
        return None

def main():
    if len(sys.argv) < 2:
        print("Usage: rag-convert <input-file> [output-file]")
        sys.exit(1)

    input_path = os.path.abspath(sys.argv[1])
    if not os.path.exists(input_path):
        print(f"File not found: {input_path}", file=sys.stderr)
        sys.exit(1)

    filename = os.path.basename(input_path)
    base_name = os.path.splitext(filename)[0]
    title = base_name.replace("_", " ").replace("-", " ").title()

    if len(sys.argv) >= 3:
        output_path = os.path.abspath(sys.argv[2])
    else:
        # Save to docs/ relative to project root or current working dir
        docs_dir = os.path.expanduser("~/Projetos/emacsConfig/MyEmacs/docs")
        if not os.path.exists(docs_dir):
            docs_dir = os.path.abspath("docs")
        output_path = os.path.join(docs_dir, f"{base_name}.org")

    print(f"📄 Processing: {input_path}")
    raw_text = convert_to_markdown(input_path)

    prompt = f"""Estruture o conteúdo abaixo como um documento Org-Mode padronizado para RAG Cache.

REQUISITOS OBRIGATÓRIOS:
1. Inclua os metadados no topo:
   #+TITLE: {title}
   #+AUTHOR: Carlos Filho
   #+FILETAGS: :RAG:DOCS:
2. Use títulos de seção Org-Mode com '*' (* Título, ** Subtítulo).
3. Mantenha tabelas formatadas em estilo Org (| col | col |).
4. Retorne APENAS o código Org-Mode puro (sem marcas ```org).

CONTEÚDO:
{raw_text[:10000]}
"""

    print("🤖 Formatting to Org-Mode via Ollama (qwen2.5-coder:3b)...")
    org_content = query_ollama(prompt)

    if not org_content:
        print("⚠️ Failed to receive output from Ollama; saving fallback raw Org file.", file=sys.stderr)
        org_content = f"#+TITLE: {title}\n#+AUTHOR: Carlos Filho\n#+FILETAGS: :RAG:DOCS:\n\n{raw_text}"

    os.makedirs(os.path.dirname(output_path), exist_ok=True)
    with open(output_path, "w", encoding="utf-8") as f:
        f.write(org_content)

    print(f"✅ Document converted to Org-Mode: {output_path}")

if __name__ == "__main__":
    main()
